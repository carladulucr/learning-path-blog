<%= form_with model: blog_post, class: "space-y-4" do |form| %>
  <% if form.object.errors.any? %>
    <div class="p-3 bg-red-50 text-red-700 rounded-lg text-sm">
      <% form.object.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block font-semibold mb-1" %>
    <%= form.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>

  <div>
    <%= form.label :cover_image, class: "block font-semibold mb-1" %>
    <% if blog_post.cover_image.present? %>
      <div id="<%= dom_id(blog_post, :cover_image) %>" class="mb-2">
        <%= image_tag blog_post.cover_image, class: "w-1/3 rounded-lg" %>
        <%= link_to "Remove cover image", blog_post_cover_image_path(blog_post), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-sm text-red-600" %>
      </div>
    <% end %>
    <%= form.file_field :cover_image %>
  </div>

  <div>
    <%= form.label :content, class: "block font-semibold mb-1" %>
    <%= form.rich_text_area :content %>
  </div>

  <div>
    <%= form.label :published_at, class: "block font-semibold mb-1" %>
    <%= form.datetime_select :published_at, include_blank: true %>
  </div>

  <%= form.button class: "bg-black text-white px-5 py-2 rounded-lg font-medium hover:bg-gray-800 cursor-pointer" %>
<% end %>
